<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fishbot">
    <xacro:include filename="$(find hello_robot)/urdf/base.urdf.xacro"/>
    <xacro:include filename="$(find hello_robot)/urdf/sensor/imu.urdf.xacro"/>
    <xacro:include filename="$(find hello_robot)/urdf/sensor/camera.urdf.xacro"/>
    <xacro:include filename="$(find hello_robot)/urdf/sensor/laser.urdf.xacro"/>
    <!-- 基座 -->
    <xacro:base_xacro length="0.12" radius="0.1"/>
    <!-- IMU传感器 -->
    <xacro:imu_xacro imu_name="imu_up" xyz="0.0 0.0 0.03"/>
    <xacro:imu_xacro imu_name="imu_down" xyz="0.0 0.0 -0.03"/>
    <!-- 相机传感器 -->
    <xacro:camera_xacro xyz="0.1 0.0 0.075"/>
    <!-- 激光传感器 -->
    <xacro:laser_xacro xyz="0.0 0.0 0.10"/>
</robot>